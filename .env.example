API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO

# Shared secret used by TradingView webhook payload.
WEBHOOK_SECRET=replace_with_long_random_secret

# Start in dry-run to validate payloads first.
TRADING_ENABLED=false
DRY_RUN=true

# Coinbase Advanced Trade API credentials.
# Create API key and private key in Coinbase settings.
COINBASE_API_KEY_NAME=organizations/{org_id}/apiKeys/{key_id}
COINBASE_PRIVATE_KEY_PEM="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"
COINBASE_API_BASE_URL=https://api.coinbase.com
COINBASE_TIMEOUT_SECONDS=10
DEFAULT_PRODUCT_ID=BTC-USD

# Risk controls
MAX_NOTIONAL_PER_TRADE_USD=500
MAX_POSITION_NOTIONAL_USD=2500
MAX_DAILY_LOSS_USD=750
MAX_OPEN_POSITIONS=2
MAX_DRAWDOWN_PCT=8
INITIAL_EQUITY_USD=100000

# Persistence + replay/idempotency
SQLITE_DB_PATH=data/bot.db
REPLAY_WINDOW_SECONDS=600
IDEMPOTENCY_TTL_SECONDS=259200
